#!/bin/sh

echo "================================================="
echo "  CareFlow HMS Pre-Commit Formatter & Check"
echo "================================================="

echo ""
echo "[1/2] Auto-formatting Frontend (Prettier)..."
if [ -d "frontend" ]; then
    cd frontend
    npm run format
    cd ..
fi

echo ""
echo "[2/2] Auto-formatting Backend (.NET)..."
dotnet format HospitalManagement.slnx

echo ""
echo "Adding updated formatted files to git commit..."
git add -u

echo "✅ Pre-commit formatting completed."
exit 0

