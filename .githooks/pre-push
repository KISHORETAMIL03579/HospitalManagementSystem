#!/bin/sh

echo "================================================="
echo "  CareFlow HMS Pre-Push Quality & Build Check"
echo "================================================="

echo ""
echo "[1/5] Checking Frontend Formatting (Prettier)..."
if [ -d "frontend" ]; then
    cd frontend
    npm run format:check
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Push blocked: Frontend code is not properly formatted."
        echo "💡 Run 'npm run format' inside frontend directory to fix."
        exit 1
    fi
    cd ..
fi

echo ""
echo "[2/5] Running Frontend Linting (oxlint)..."
if [ -d "frontend" ]; then
    cd frontend
    npm run lint
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Push blocked: Frontend linting check failed."
        exit 1
    fi
    cd ..
fi

echo ""
echo "[3/5] Verifying Frontend Build & TypeScript..."
if [ -d "frontend" ]; then
    cd frontend
    npm run build
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Push blocked: Frontend build or TypeScript checks failed."
        exit 1
    fi
    cd ..
fi

echo ""
echo "[4/5] Checking Backend (.NET) Formatting..."
dotnet format HospitalManagement.slnx --verify-no-changes
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Push blocked: Backend C# code formatting check failed."
    echo "💡 Run 'dotnet format HospitalManagement.slnx' to fix formatting."
    exit 1
fi

echo ""
echo "[5/5] Running Backend (.NET) Unit Tests..."
dotnet test HospitalManagement.slnx
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Push blocked: Backend unit tests failed."
    exit 1
fi

echo ""
echo "✅ All frontend and backend formatting, linting, build, and unit tests passed! Push permitted."
exit 0
